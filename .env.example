# ---------------------------------------------------------------- required
# 32-byte key for the AES-256-GCM envelope that seals BYOK tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OMNIGTM_ENCRYPTION_KEY=

# Operator password for the dashboard. Mutations are refused without a session.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OMNIGTM_DASHBOARD_TOKEN=

# Public origin, used in preview links inside outreach emails.
OMNIGTM_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- storage
# Postgres (Neon / Supabase / Render) when set, otherwise a local SQLite file.
DATABASE_URL=
OMNIGTM_DB_PATH=.data/omnigtm.db
OMNIGTM_MEDIA_DIR=.data/previews

# ---------------------------------------------------------------- LLM chain
# Free tiers only. Any provider without a key is skipped, never defaulted.
GROQ_API_KEY=
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/gpt-6-luna
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Override a retired free model without touching code.
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# GEMINI_MODEL=gemini-2.5-flash
# NIM_MODEL=deepseek-ai/deepseek-v4.1-flash

# Custom OpenAI-compatible aggregator (FreeLLMAPI, LiteLLM, vLLM, ...).
# Endpoints can also be added at runtime in Settings - they are sealed in the DB.
FREELMAPI_BASE_URL=
FREELMAPI_API_KEY=
FREELMAPI_MODEL=auto
FREELMAPI_PRIORITY=5

# ---------------------------------------------------------------- outbound
# JSON array of sending mailboxes. Caps are enforced per mailbox, per UTC day.
# [{"email":"you@studio.com","provider":"BREVO_SMTP","dailyCap":35},
#  {"email":"second@gmail.com","provider":"GMAIL_OAUTH","dailyCap":35,"refreshTokenEnv":"GMAIL_REFRESH_TOKEN_2"}]
OMNIGTM_MAILBOXES=

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Signhify Studio
BREVO_DAILY_CAP=150

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---------------------------------------------------------------- social
IG_BUSINESS_ACCOUNT_ID=
IG_LONG_LIVED_ACCESS_TOKEN=
IG_WEBHOOK_VERIFY_TOKEN=
IG_WEBHOOK_SECRET=
OMNIGTM_CTA_KEYWORD=FOSS
OMNIGTM_ALLOW_PRIVATE_ENDPOINTS=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- media
# Optional explicit font for FFmpeg drawtext.
# OMNIGTM_FONT_FILE=C:/Windows/Fonts/segoeuib.ttf

# ---------------------------------------------------------------- ops
OMNIGTM_LOG_LEVEL=info
# OMNIGTM_OFFLINE_TEST=1   # deterministic mocks for tests/CI only
